{
  "name": "fyllut-ettersending",
  "version": "0.1.0",
  "main": "server.js",
  "repository": "git@github.com:navikt/fyllut-ettersending.git",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "rimraf node_modules .next mocks/node_modules",
    "dev": "next dev --webpack -p 3002",
    "dev:test": "NODE_ENV=test next dev --webpack -p 3002",
    "build": "next build --webpack",
    "typegen": "next typegen",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "cypress": "cypress run",
    "cypress:open": "cypress open",
    "mocks": "cd mocks && yarn mocks",
    "mocks:no-cli": "cd mocks && yarn mocks:no-cli",
    "prepare": "yarn typegen && husky",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.18.0",
    "@navikt/ds-css": "8.18.0",
    "@navikt/ds-react": "8.18.0",
    "@navikt/fnrvalidator": "^2.2.1",
    "@navikt/nav-dekoratoren-moduler": "4.5.0",
    "classnames": "^2.5.1",
    "file-saver": "^2.0.5",
    "html-react-parser": "6.1.8",
    "i18next": "26.4.2",
    "jsdom": "30.1.2",
    "next": "16.4.1",
    "next-i18next": "16.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@mocks-server/cypress-commands": "^6.1.1",
    "@testing-library/cypress": "^10.1.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "axe-core": "4.14.0",
    "cross-env": "^10.1.0",
    "cypress": "15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "typescript-eslint": "8.71.1"
  }
}
